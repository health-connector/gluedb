.page-header
  %h4 Trading Partner Transforms
  %p.text-muted
    Generates source XML, X12 (834) and CV1 files for the given policies and downloads them as a single zip named after the ticket number.

= form_for @transform_request, :as => :trading_partner_transform_request, :url => trading_partner_transforms_path, :html => {:autocomplete => "off", :multipart => true} do |f|

  .tpt-section
    %h5.tpt-section-title 1. Policies
    .tpt-prep-warning
      %strong Multiple eg_ids:
      = " All eg_ids in one request are processed as a single batch. For Terminate, the one end date you enter is applied to every policy. For Cancel, every policy must share the same policy start date, since Cancel sets each end date automatically. If your policies would not end up with the same result, apply the change to them separately."
    .row
      .col-sm-9.col-md-6
        .form-group
          = f.label :eg_ids, "Policy eg_ids (comma separated)"
          = f.text_field :eg_ids, :class => "form-control", :placeholder => "814228, 814229"

  %hr.tpt-divider

  .tpt-section
    %h5.tpt-section-title 2. Data Preparation
    .alert.alert-warning.tpt-prep-warning
      %strong Note:
      Remove End Date, Terminate or Cancel with End Date, and Remove COBRA Eligibility Date all update policy records in the database before any transform is generated. A confirmation screen shows the exact changes before anything is applied.

    .form-group
      = f.label :end_date_action, "Data Preparation Action"
      = f.select :end_date_action, [["None - no data changes needed", "none"], ["Remove End Date", "remove"], ["Terminate or Cancel with End Date", "change"], ["Remove COBRA Eligibility Date", "remove_cobra"]], {}, :class => "form-control tpt-select-action"

    #prep-desc-none.tpt-prep-action-desc
      No data changes needed. Proceed directly to Transform Generation.
    #prep-desc-remove.tpt-prep-action-desc
      Clears enrollee end dates and reactivates coverage. Run before an initial or reinstate transform.
    #prep-desc-change.tpt-prep-action-desc
      Sets an end date on every enrollee. The policy becomes canceled when the end date equals the policy start date and terminated otherwise.
    #prep-desc-remove_cobra.tpt-prep-action-desc
      Clears the cobra eligibility date stored on the policy. There is no rake task for this.

    #remove-fields.tpt-prep-card-fields
      .row
        .col-sm-4.col-md-3
          .form-group
            = f.label :aasm_state, "Restore Policy State To"
            = f.select :aasm_state, TradingPartnerTransformRequest::REMOVE_AASM_STATES, {}, :class => "form-control"
        .col-sm-4.col-md-3
          .form-group
            = f.label :benefit_status, "Benefit Status"
            = f.select :benefit_status, TradingPartnerTransformRequest::BENEFIT_STATUSES, {}, :class => "form-control"

    #change-mode-fields.tpt-prep-card-fields
      .radio
        %label
          = f.radio_button :change_mode, "terminate"
          %strong Terminate
          = " - enter the end date below"
      .radio
        %label
          = f.radio_button :change_mode, "cancel"
          %strong Cancel
          = " - end date is set automatically to the policy start date"
      #terminate-end-date
        .form-group
          = f.label :end_date, "End Date"
          = f.text_field :end_date, :class => "form-control tpt-input-sm", :placeholder => "MM/DD/YYYY", :maxlength => 10, :pattern => '\d{2}/\d{2}/\d{4}', :inputmode => "numeric", :autocomplete => "off"
          %p.tpt-help Must be after the policy start date and no more than one year after it. Use Cancel if the end date should equal the start date.

    .tpt-actions-row
      = f.submit "Apply Data Changes", :formaction => apply_data_changes_trading_partner_transforms_path, :class => "btn btn-info", :id => "apply-btn"

  %hr.tpt-divider

  .tpt-section
    %h5.tpt-section-title 3. Transform Generation
    .row
      .col-sm-3
        .form-group
          = f.label :ticket_number, "Ticket Number (optional)"
          = f.text_field :ticket_number, :class => "form-control tpt-input-sm", :placeholder => "CCAOM-297"
      .col-sm-3
        .form-group
          = f.label :reason_code, "Reason Code"
          = f.select :reason_code, TradingPartnerTransformRequest.reason_code_options, {}, :class => "form-control tpt-select-sm"
    %p.tpt-help
      Generate & Download produces source XML, X12 and CV1. Generate Source XML Only produces just the source XML, useful when it needs review before the X12 and CV1 transform is created.
    .tpt-actions-row
      = f.submit "Generate & Download", :class => "btn btn-primary", :id => "generate-btn"
      = f.submit "Generate Source XML Only", :formaction => generate_source_only_trading_partner_transforms_path, :class => "btn btn-info", :id => "generate-source-btn"

  %hr.tpt-divider

  .tpt-section
    %h5.tpt-section-title 4. Transform Uploaded Source XML
    %p.tpt-help
      Upload one or more source XML files, such as the ones Generate Source XML Only produces, to create their X12 and CV1 transform. This does not look up or change any policy. Only .xml files are accepted.
    .form-group
      = label_tag :source_xml_files, "Source XML Files (.xml, choose multiple)"
      = file_field_tag "source_xml_files[]", :multiple => true, :accept => ".xml", :class => "form-control", :id => "source_xml_files"
    .tpt-actions-row
      = f.submit "Transform Uploaded XML", :formaction => transform_uploaded_xmls_trading_partner_transforms_path, :class => "btn btn-info", :id => "transform-upload-btn", :disabled => true

:javascript
  $(function() {
    function syncPrepFields() {
      var action = $("#trading_partner_transform_request_end_date_action").val();
      var changeMode = $("input[name='trading_partner_transform_request[change_mode]']:checked").val();
      var showEndDate = (action === "change") && (changeMode === "terminate");

      // Show only the description that matches the selected action
      $(".tpt-prep-action-desc").hide();
      $("#prep-desc-" + action).show();

      // Show policy state and benefit status fields only for Remove End Date
      $("#remove-fields").toggle(action === "remove");
      $("#remove-fields select").prop("disabled", action !== "remove");

      // Show the terminate or cancel sub-options only when that action is selected
      $("#change-mode-fields").toggle(action === "change");
      $("#change-mode-fields input[name='trading_partner_transform_request[change_mode]']").prop("disabled", action !== "change");

      // Show the end date input only when terminate mode is selected
      $("#terminate-end-date").toggle(showEndDate);
      $("#terminate-end-date input").prop("disabled", !showEndDate);

      // Disable the Apply button when no data change action is selected
      $("#apply-btn").prop("disabled", action === "none");
    }

    $("#trading_partner_transform_request_end_date_action").on("change", syncPrepFields);
    $("input[name='trading_partner_transform_request[change_mode]']").on("change", syncPrepFields);

    // Only allow digits in End Date, and insert the slashes automatically
    // so the field always reads as MM/DD/YYYY
    $("#trading_partner_transform_request_end_date").on("input", function() {
      var digits = this.value.replace(/\D/g, "").slice(0, 8);
      var formatted = digits;
      if (digits.length > 4) {
        formatted = digits.slice(0, 2) + "/" + digits.slice(2, 4) + "/" + digits.slice(4);
      } else if (digits.length > 2) {
        formatted = digits.slice(0, 2) + "/" + digits.slice(2);
      }
      this.value = formatted;
    });

    // Apply correct state on initial page load
    syncPrepFields();

    function syncGenerateSection() {
      var hasCode = $("#trading_partner_transform_request_reason_code").val() !== "";

      // Disable the Generate buttons when no reason code is selected
      $("#generate-btn").prop("disabled", !hasCode);
      $("#generate-source-btn").prop("disabled", !hasCode);
    }

    $("#trading_partner_transform_request_reason_code").on("change", syncGenerateSection);

    // Apply correct initial state for the Generate section
    syncGenerateSection();

    function syncUploadSection() {
      var fileInput = document.getElementById("source_xml_files");
      var hasFiles = fileInput && fileInput.files.length > 0;

      // Disable the upload transform button until at least one file is chosen
      $("#transform-upload-btn").prop("disabled", !hasFiles);
    }

    $("#source_xml_files").on("change", syncUploadSection);

    // Apply correct initial state for the upload section
    syncUploadSection();

    // After the download starts, reset the form so the page is clean for the next request
    function resetFormState() {
      document.querySelector("form").reset();
      syncPrepFields();
      syncGenerateSection();
      syncUploadSection();
    }

    $("#generate-btn, #generate-source-btn, #transform-upload-btn").on("click", function() {
      setTimeout(resetFormState, 2000);
    });

    // Reset the form when the browser restores the page from its navigation cache
    window.addEventListener("pageshow", function(event) {
      if (event.persisted) {
        resetFormState();
      }
    });
  });
